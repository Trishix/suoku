            "type": "array",
            "title": "Evidence Timestamps"
          },
          "recipe_id": {
            "type": "string",
            "title": "Recipe Id"
          },
          "recipe_fingerprint": {
            "type": "string",
            "title": "Recipe Fingerprint"
          },
          "provider_fingerprint": {
            "type": "string",
            "title": "Provider Fingerprint"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "asset_id",
          "source_hash",
          "start_ms",
          "end_ms",
          "summary",
          "payload",
          "evidence_timestamps",
          "recipe_id",
          "recipe_fingerprint",
          "provider_fingerprint",
          "prompt_version"
        ],
        "title": "Observation"
      },
