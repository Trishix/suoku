  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "recipe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/RecipeBody"
              }
            ],
            "title": "Recipe",
            "default": "general"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Asset Id"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Ms",
            "default": 0
          },
          "end_ms": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_id"
        ],
        "title": "AnalysisRequest"
      },
      "AnswerRequest": {
        "properties": {
          "recipe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/RecipeBody"
              }
            ],
            "title": "Recipe",
            "default": "general"
          },
          "question": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Question"
          },
          "asset_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 100,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Ids"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "candidate_limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Candidate Limit",
            "default": 6
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerRequest"
      },
      "Citation": {
        "properties": {
          "observation_id": {
            "type": "string",
            "title": "Observation Id"
          },
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "start_ms": {
            "type": "integer",
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "title": "End Ms"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "observation_id",
          "asset_id",
          "start_ms",
          "end_ms",
          "reason"
        ],
        "title": "Citation"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "Filters": {
        "properties": {
          "camera_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Id"
          },
          "recorded_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded After"
          },
          "recorded_before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded Before"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Filters"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InsightAnswer": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "provider_fingerprint": {
            "type": "string",
            "title": "Provider Fingerprint"
          },
          "insufficient_evidence": {
            "type": "boolean",
            "title": "Insufficient Evidence",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citations",
          "limitations",
          "provider_fingerprint"
        ],
        "title": "InsightAnswer"
      },
      "JobBody": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ingest",
              "search",
              "remove",
              "purge",
              "analysis",
              "answer"
            ],
            "title": "Kind"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "State"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "state",
          "progress",
          "created_at",
          "updated_at"
        ],
        "title": "JobBody"
      },
      "JobResult": {
        "properties": {
          "asset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Id"
          },
          "matches": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/MatchBody"
