              },
              {
                "type": "null"
              }
            ],
            "title": "Matches"
          },
          "observations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Observation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observations"
          },
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InsightAnswer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "JobResult"
      },
      "MatchBody": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "timestamp_ms": {
            "type": "integer",
            "title": "Timestamp Ms"
          },
          "start_ms": {
            "type": "integer",
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "title": "End Ms"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "source_hash": {
            "type": "string",
            "title": "Source Hash"
          },
          "model_fingerprint": {
            "type": "string",
            "title": "Model Fingerprint"
          },
          "camera_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Id"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "timestamp_ms",
          "start_ms",
          "end_ms",
          "score",
          "source_hash",
          "model_fingerprint",
          "camera_id"
        ],
        "title": "MatchBody"
      },
      "Observation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "source_hash": {
            "type": "string",
            "title": "Source Hash"
          },
          "start_ms": {
            "type": "integer",
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "title": "End Ms"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "evidence_timestamps": {
            "items": {
              "type": "integer"
