            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "schema": {
            "additionalProperties": true,
